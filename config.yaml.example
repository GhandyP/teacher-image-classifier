gemini:
  model: gemini-2.5-flash
  timeout_s: 30
rate_limit:
  requests_per_minute: 60
retry:
  max_attempts: 5
  min_backoff_s: 0.5
  max_backoff_s: 8.0
scoring:
  min_confidence: 0.0
  weights:
    overall: 1.0
logging:
  level: INFO
  json: true
# Keep the local image-size cap and remote URL ingestion disabled for privacy.
image:
  max_bytes: 10485760  # 10 MiB maximum image size.
  allow_remote_urls: false  # Local paths only by default.
